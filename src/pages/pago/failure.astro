---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pago Fallido - TechNova">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center py-12">
    <div class="max-w-md mx-auto text-center px-4">
      <div class="bg-white rounded-2xl shadow-xl p-8 animate-fade-in">
        <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
        
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          Pago No Completado
        </h1>
        
        <p class="text-gray-600 mb-6">
          Hubo un problema al procesar tu pago. Por favor, intenta nuevamente o utiliza otro método de pago.
        </p>
        
        <div class="bg-red-50 rounded-lg p-4 mb-6">
          <p class="text-red-800 font-medium">
            El pago fue rechazado
          </p>
          <p class="text-red-600 text-sm">
            Verifica los datos de tu tarjeta o intenta con otro método
          </p>
        </div>
        
        <div class="space-y-3">
          <a href="/carrito" class="btn-primary inline-block w-full">
            Volver al Carrito
          </a>
          <a href="/contacto" class="btn-secondary inline-block w-full">
            Contactar Soporte
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

