---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pago Pendiente - TechNova">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center py-12">
    <div class="max-w-md mx-auto text-center px-4">
      <div class="bg-white rounded-2xl shadow-xl p-8 animate-fade-in">
        <div class="w-20 h-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        
        <h1 class="text-3xl font-bold text-gray-900 mb-4">
          Pago Pendiente
        </h1>
        
        <p class="text-gray-600 mb-6">
          Tu pago está siendo procesado. Te notificaremos por correo cuando se confirme.
        </p>
        
        <div class="bg-yellow-50 rounded-lg p-4 mb-6">
          <p class="text-yellow-800 font-medium">
            Procesando pago
          </p>
          <p class="text-yellow-600 text-sm">
            Esto puede tomar unos minutos
          </p>
        </div>
        
        <div class="space-y-3">
          <a href="/" class="btn-primary inline-block w-full">
            Volver al Inicio
          </a>
          <a href="/contacto" class="btn-secondary inline-block w-full">
            ¿Tienes dudas? Contáctanos
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

